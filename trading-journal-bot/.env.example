# ── Telegram ─────────────────────────────────────────────
# 向 @BotFather 申請的 Bot Token
TELEGRAM_TOKEN=
# 只回應這個 user id（可向 @userinfobot 查詢自己的 id）
TELEGRAM_ALLOWED_USER_ID=

# ── Claude AI（解析自然語言，選用）────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Webhook Server ───────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# TradingView webhook 驗證用 secret（請用長亂數，例如 openssl rand -hex 32）
WEBHOOK_SECRET=

# ── 交易設定 ─────────────────────────────────────────────
# 每口每點價值（大台=200元、小台=50元、微台=10元）
POINTS_PER_LOT=200

# ── 其他 ─────────────────────────────────────────────────
# 資料目錄（預設為專案下的 data/）
DATA_DIR=data
LOG_LEVEL=INFO
